# Resend API Key for Support Ticket Email Deliveries (Server-Side Node.js Environment)
# Obtain this key from your Resend Dashboard (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Optional: Override the recipient email address for local testing/development (defaults to admin@crickstreet.com)
RESEND_TO_EMAIL=admin@crickstreet.com
